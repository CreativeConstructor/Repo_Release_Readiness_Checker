# ==============================================================================
# Repository Release Readiness Checker - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual configuration.
# Never commit .env or any credentials into version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration [Active: Commit 3+]
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection & Pool Settings [Active: Commit 4+]
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres_user:postgres_password@localhost:5432/app_db
DB_USER=postgres_user
DB_PASSWORD=postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
# Connection pool safeguards (defend against connection starvation):
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=2000

# ------------------------------------------------------------------------------
# 3. Authentication & Security [Active: Commit 4+]
# ------------------------------------------------------------------------------
# Generate a secure 256-bit secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

# ------------------------------------------------------------------------------
# 4. Rate Limiting Safeguards [Active: Commit 4+]
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000        # 15 minutes window in milliseconds
RATE_LIMIT_MAX_GENERAL=100         # Max requests per window for /api endpoints
RATE_LIMIT_MAX_AUTH=10             # Stricter max attempts per window for /api/auth (brute-force defense)

# ------------------------------------------------------------------------------
# 5. GitHub API (Octokit) [Used in: Commit 5+]
# ------------------------------------------------------------------------------
# Optional for public repos, but recommended to prevent IP rate-limiting (60 req/hr -> 5,000 req/hr)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 6. Google Gemini AI Analysis [Used in: Commit 9+]
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 7. Redis & BullMQ Asynchronous Processing [Used in: Commit 12+]
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:password@localhost:6379
BULLMQ_CONCURRENCY=5
